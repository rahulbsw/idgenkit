WITH g AS (SELECT n, uuidv7_generate_monotonic() AS u FROM generate_series(1, 20000) n)
SELECT bool_and(u > prev) AS uuidv7_monotonic
FROM (SELECT u, lag(u) OVER (ORDER BY n) AS prev FROM g) s WHERE prev IS NOT NULL;
