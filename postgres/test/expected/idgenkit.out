WITH g AS (SELECT n, snowflake_generate() AS id FROM generate_series(1, 20000) n)
SELECT bool_and(id > prev) AS increasing
FROM (SELECT id, lag(id) OVER (ORDER BY n) AS prev FROM g) s WHERE prev IS NOT NULL;
